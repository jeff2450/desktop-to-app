{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://webtoapp.dev/config.schema.json",
  "title": "WebToApp Configuration",
  "description": "Configuration file for the webtoapp conversion pipeline",
  "type": "object",
  "required": ["name", "version", "source", "targets", "mode", "appId", "backend", "auth", "database"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for VS Code autocomplete"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable app name used in installer UI and window title"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version string (e.g. 1.0.0)",
      "examples": ["1.0.0", "2.1.3"]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute or relative path to the source project root"
    },
    "output": {
      "type": "string",
      "description": "Absolute or relative path for the converted output project. Defaults to <source>-desktop"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["windows", "linux", "mac", "android", "ios"],
        "description": "Target platform to build for"
      },
      "description": "One or more target platforms to build installers for"
    },
    "mode": {
      "type": "string",
      "enum": ["offline", "online", "hybrid"],
      "description": "offline: all data in local SQLite. online: keep cloud backend. hybrid: local + sync."
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)+$",
      "description": "Reverse-domain app identifier (e.g. com.acme.pharmacyapp)",
      "examples": ["com.acme.myapp", "io.example.pharmacy"]
    },
    "icon": {
      "type": "string",
      "description": "Path to a 512x512 PNG icon, relative to source root. Auto-detected if omitted."
    },
    "author": {
      "type": "string",
      "description": "Author name written into package.json (required by electron-builder)",
      "examples": ["Acme Corp", "Jane Doe"]
    },
    "backend": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "Backend generation strategy",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["auto", "express", "none"],
          "description": "auto: detect and replace. express: always generate local server. none: static only."
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 3001,
          "description": "Port for the local Express server"
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "Auth generation strategy",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["local", "none"],
          "description": "local: generate JWT auth backed by SQLite users table. none: strip auth (single-user)."
        },
        "defaultAdmin": {
          "type": "string",
          "format": "email",
          "description": "Default admin email for the seeded account",
          "examples": ["admin@pharmacy.local"]
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "Database migration strategy",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["sqlite", "none"],
          "description": "sqlite: use better-sqlite3. none: no database generation."
        },
        "migrations": {
          "type": "string",
          "description": "Path to Supabase SQL migrations folder, relative to source root"
        }
      }
    },
    "devTools": {
      "type": "boolean",
      "default": false,
      "description": "Open Electron DevTools in the output app"
    },
    "verbose": {
      "type": "boolean",
      "default": false,
      "description": "Enable verbose pipeline logging"
    },
    "dryRun": {
      "type": "boolean",
      "default": false,
      "description": "Log every planned action but skip all file writes and npm installs"
    },
    "resumeFromStage": {
      "type": "string",
      "enum": ["01-detect", "02-plan", "03-transform", "04-scaffold", "05-install", "06-build", "07-package", "07b-mobile"],
      "description": "Resume the pipeline from this stage, skipping earlier completed stages"
    },
    "cleanLogs": {
      "type": "boolean",
      "default": false,
      "description": "Delete the conversion log file after a successful pipeline run"
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mobile-specific build settings. Only used when 'android' or 'ios' appears in targets.",
      "properties": {
        "android": {
          "type": "object",
          "additionalProperties": false,
          "description": "Android build overrides",
          "properties": {
            "minSdkVersion": {
              "type": "integer",
              "minimum": 21,
              "default": 22,
              "description": "Minimum Android SDK version (22 = Android 5.1)"
            },
            "buildVariant": {
              "type": "string",
              "enum": ["debug", "release"],
              "default": "debug",
              "description": "debug: unsigned APK for testing. release: signed APK for Play Store."
            },
            "keystorePath": {
              "type": "string",
              "description": "Path to the release keystore file, relative to source root"
            },
            "keystoreAlias": {
              "type": "string",
              "description": "Keystore alias for release signing"
            },
            "keystorePassword": {
              "type": "string",
              "description": "Keystore password for release signing"
            }
          }
        },
        "ios": {
          "type": "object",
          "additionalProperties": false,
          "description": "iOS build overrides (macOS only)",
          "properties": {
            "deploymentTarget": {
              "type": "string",
              "default": "13.0",
              "description": "Minimum iOS deployment target, e.g. '13.0'",
              "examples": ["13.0", "14.0", "15.0"]
            },
            "developmentTeam": {
              "type": "string",
              "description": "Apple developer team ID for Xcode signing. Found in Xcode → Signing & Capabilities.",
              "examples": ["ABCD1234EF"]
            }
          }
        }
      }
    }
  }
}
