# ─────────────────────────────────────────────────────────────────────────────
# WebToApp API — Environment Variables
# Copy to .env and fill in values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://webtoapp:secret@localhost:5432/webtoapp

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (generate with: openssl rand -base64 48) ─────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── File storage (leave blank in dev — uses local disk fallback) ─────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=webtoapp-artifacts

# ── Upload limits ─────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=200
UPLOADS_DIR=uploads
OUTPUTS_DIR=outputs

# ── Stripe (optional — billing routes return 503 if absent) ──────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# DASHBOARD_URL=http://localhost:3000

# ClickPesa Hosted Checkout (optional - used by dashboard billing when set)
# Create a Hosted application in ClickPesa with Hosted Checkout enabled.
# CLICKPESA_CLIENT_ID=
# CLICKPESA_API_KEY=
# CLICKPESA_CURRENCY=USD
# CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties

# ── Email (optional) ──────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=billing@webtoapp.dev
