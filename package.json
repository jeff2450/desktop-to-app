{
  "name": "webtoapp",
  "version": "1.0.0",
  "private": true,
  "description": "AI Web App → Native Desktop Converter",
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose up -d postgres redis && pnpm --filter @webtoapp/api db:sync && turbo run dev dev:worker",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
