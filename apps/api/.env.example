# ── Vodacom M-Pesa (Tanzania OpenAPI) ─────────────────────────────────────────
# Register at https://openapiportal.m-pesa.com to get these credentials.
# Requires an approved M-Pesa Business Account (Tanzania).
#
# MPESA_API_KEY         — Your application's API Key from the developer portal
# MPESA_PUBLIC_KEY      — Vodacom's RSA public key (used to encrypt API_KEY → Bearer token)
#                         Get from: https://openapiportal.m-pesa.com (app > API Key section)
# MPESA_SERVICE_PROVIDER_CODE — Your business ShortCode (e.g. 400000)
# MPESA_BASE_URL        — Sandbox: https://openapi.m-pesa.com/sandbox/ipg/v2/vodacomTZN/
#                         Production: https://openapi.m-pesa.com/openapi/ipg/v2/vodacomTZN/
# MPESA_CURRENCY        — TZS (Tanzanian Shilling, default) or USD
# MPESA_CALLBACK_URL    — Public HTTPS URL where Vodacom POSTs payment results
#                         e.g. https://yourdomain.com/api/billing/mpesa/callback
#                         (must be publicly reachable; use ngrok for local testing)
MPESA_API_KEY=""
MPESA_PUBLIC_KEY=""
MPESA_SERVICE_PROVIDER_CODE=""
MPESA_BASE_URL="https://openapi.m-pesa.com/sandbox/ipg/v2/vodacomTZN/"
MPESA_CURRENCY="TZS"
MPESA_CALLBACK_URL=""
