# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/webtoapp

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── AWS S3 (or compatible — Cloudflare R2, MinIO) ─────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=webtoapp-installers
# Optional: set for R2 / MinIO
# S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.webtoapp.dev

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_token
MAX_REPO_SIZE_MB=500

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=WebToApp <noreply@webtoapp.dev>

# ── Anthropic (AI fallback transformer) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://webtoapp.dev
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGINS=https://webtoapp.dev,http://localhost:3001

# ── Worker ────────────────────────────────────────────────────────────────────
RUN_WORKER=true
USE_DOCKER=true
WORKER_CONCURRENCY=2
DOCKER_BUILDER_IMAGE=webtoapp/builder:latest
DOCKER_TIMEOUT_MS=1800000
INTERNAL_WEBHOOK_SECRET=change-me-internal-secret
