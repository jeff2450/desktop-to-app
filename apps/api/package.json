{
  "name": "@webtoapp/api",
  "version": "1.0.0",
  "description": "WebToApp SaaS API — Express + BullMQ + PostgreSQL",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "psql $DATABASE_URL < src/db/migrations/001_init.sql",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@webtoapp/core": "workspace:*",
    "@webtoapp/detectors": "workspace:*",
    "@webtoapp/transformers": "workspace:*",
    "@webtoapp/builder": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.31.0",
    "express": "^4.19.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "stripe": "^15.12.0",
    "adm-zip": "^0.5.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
  }
}
