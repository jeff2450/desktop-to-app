# WebToApp — Next.js dashboard environment variables
# Copy this file to .env.web and fill in the values

# ── API connection ────────────────────────────────────────────────────────────
# In local dev, this should point to the API container or localhost
# When using docker-compose: http://api:3001 (internal network)
# When running outside Docker: http://localhost:3001
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Stripe (public key only — secret key stays in the API) ───────────────────
# Get from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Flutterwave hosted checkout
# Secret key stays server-side. Currency can be USD, NGN, KES, GHS, TZS, UGX, ZAR, etc.
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST..."
FLUTTERWAVE_CURRENCY="USD"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID="AVZ3wuYtpafJw4T1bqh7r4zC0ml399HLmvjLxIMlyxY_XlrMiNYU-Q3p-2tuWnns_7cTtdttBmS9Wq2X"
