# GitHub Actions — Cross-Platform Build & Release
# Generated by WebToApp (webtoapp.config.json → ci.provider = "github-actions")
#
# REQUIRED SECRETS (set in repo Settings → Secrets and variables → Actions):
#
#   Desktop signing:
#     WIN_CSC_LINK           Base64-encoded .pfx certificate  (Windows signing)
#     WIN_CSC_KEY_PASSWORD   Password for the .pfx            (Windows signing)
#     CSC_LINK               Base64-encoded .p12 certificate  (macOS signing)
#     CSC_KEY_PASSWORD       Password for the .p12            (macOS signing)
#     APPLE_ID               Apple ID email                   (macOS notarization)
#     APPLE_APP_SPECIFIC_PASSWORD  App-specific password      (macOS notarization)
#     APPLE_TEAM_ID          10-char developer team ID        (macOS notarization)
#
#   GitHub Releases (for electron-updater):
#     GH_TOKEN               GitHub token with repo + write:packages scope
#                            (Actions already provides GITHUB_TOKEN, but you may
#                             need a PAT for private repos / cross-repo releases)

name: Build & Release

on:
  push:
    tags:
      - 'v[0-9]+.[0-9]+.[0-9]+'   # Trigger on version tags: v1.2.3
  workflow_dispatch:                 # Allow manual runs from the Actions tab

permissions:
  contents: write      # Needed to create GitHub Releases
  actions: read

jobs:
  build:
    name: Build (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30

    strategy:
      fail-fast: false   # Build all platforms even if one fails
      matrix:
        include:
          - os: windows-latest
            target: windows
            artifact: release/*.exe
          - os: macos-latest
            target: mac
            artifact: release/*.dmg
          - os: ubuntu-latest
            target: linux
            artifact: release/*.AppImage

    steps:
      # ── Checkout ────────────────────────────────────────────────────────────
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # ── Node.js ─────────────────────────────────────────────────────────────
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      # ── Install dependencies ─────────────────────────────────────────────────
      - name: Install dependencies
        run: npm ci

      # ── Build the web app ────────────────────────────────────────────────────
      - name: Build web app
        run: npm run build

      # ── Package with electron-builder ────────────────────────────────────────
      - name: Package (${{ matrix.target }})
        env:
          # Windows signing (leave empty if you don't have a cert yet)
          WIN_CSC_LINK:          ${{ secrets.WIN_CSC_LINK }}
          WIN_CSC_KEY_PASSWORD:  ${{ secrets.WIN_CSC_KEY_PASSWORD }}
          # macOS signing + notarization
          CSC_LINK:              ${{ secrets.CSC_LINK }}
          CSC_KEY_PASSWORD:      ${{ secrets.CSC_KEY_PASSWORD }}
          APPLE_ID:              ${{ secrets.APPLE_ID }}
          APPLE_APP_SPECIFIC_PASSWORD: ${{ secrets.APPLE_APP_SPECIFIC_PASSWORD }}
          APPLE_TEAM_ID:         ${{ secrets.APPLE_TEAM_ID }}
          # GitHub token for publishing the release
          GH_TOKEN:              ${{ secrets.GITHUB_TOKEN }}
        run: npx electron-builder --${{ matrix.target }} --publish always

      # ── Upload artifact for inspection ───────────────────────────────────────
      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: installer-${{ matrix.target }}
          path: ${{ matrix.artifact }}
          retention-days: 14

  # Optional: notify your team on Slack/Discord after all builds complete
