/**
 * SQLite database setup — generated by WebToApp
 * Uses better-sqlite3 for fast, synchronous, zero-config local storage.
 * Detected tables: {{#each tables}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
 */
const Database = require('better-sqlite3');
const path = require('path');
const fs = require('fs');

let db;

// ─── Path resolution ──────────────────────────────────────────────────────────

function getDbPath() {
  if (process.versions.electron) {
    // Running inside packaged Electron — store in user data directory
    const { app } = require('electron');
    const dir = app.getPath('userData');
    fs.mkdirSync(dir, { recursive: true });
    return path.join(dir, 'app.db');
  }
  // Dev / standalone Node — store in .data/ next to backend/
  const dir = path.join(__dirname, '..', '.data');
  fs.mkdirSync(dir, { recursive: true });
  return path.join(dir, 'app.db');
}

// ─── Migrations ───────────────────────────────────────────────────────────────

function runMigrations(database) {
  // Create migrations tracking table
  database.exec(`
    CREATE TABLE IF NOT EXISTS _migrations (
      id   INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT UNIQUE NOT NULL,
      run_at TEXT DEFAULT (datetime('now'))
    )
  `);

  const migrations = [
    {
      name: '001_initial_schema',
      sql: `
        {{#each tables}}
        CREATE TABLE IF NOT EXISTS {{this}} (
          id         TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
          created_at TEXT DEFAULT (datetime('now')),
          updated_at TEXT DEFAULT (datetime('now'))
        );
        CREATE TRIGGER IF NOT EXISTS {{this}}_updated_at
          AFTER UPDATE ON {{this}}
          BEGIN
            UPDATE {{this}} SET updated_at = datetime('now') WHERE id = NEW.id;
          END;
        {{/each}}
      `,
    },
  ];

  const insertMigration = database.prepare(
    'INSERT OR IGNORE INTO _migrations (name) VALUES (?)'
  );
  const hasMigration = database.prepare(
    'SELECT id FROM _migrations WHERE name = ?'
  );

  for (const migration of migrations) {
    if (!hasMigration.get(migration.name)) {
      database.exec(migration.sql);
      insertMigration.run(migration.name);
      console.log(`[db] Applied migration: ${migration.name}`);
    }
  }
}

// ─── Init ─────────────────────────────────────────────────────────────────────

function initDatabase() {
  const dbPath = getDbPath();
  db = new Database(dbPath, { verbose: process.env.NODE_ENV === 'development' ? console.log : undefined });

  // Performance pragmas
  db.pragma('journal_mode = WAL');
  db.pragma('synchronous = NORMAL');
  db.pragma('foreign_keys = ON');
  db.pragma('cache_size = -64000'); // 64 MB cache
  db.pragma('temp_store = MEMORY');

  runMigrations(db);
  console.log(`[db] Ready at ${dbPath}`);
  return db;
}

function getDb() {
  if (!db) throw new Error('Database not initialised — call initDatabase() first');
  return db;
}

function closeDb() {
  if (db) {
    db.close();
    db = undefined;
  }
}

process.on('exit', closeDb);
process.on('SIGINT', () => { closeDb(); process.exit(0); });
process.on('SIGTERM', () => { closeDb(); process.exit(0); });

module.exports = { initDatabase, getDb, closeDb };
