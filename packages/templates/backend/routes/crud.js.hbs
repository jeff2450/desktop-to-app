/**
 * CRUD routes for '{{table}}' — generated by WebToApp
 * Mirrors PostgREST API conventions so localApi.from('{{table}}') works unchanged.
 */
const express = require('express');
const crypto = require('crypto');
const { getDb } = require('../database.cjs');
{{#if policies}}
const { requireAuth } = require('../auth.cjs');
{{/if}}

const router = express.Router();
const TABLE = '{{table}}';

// ─── Helpers ──────────────────────────────────────────────────────────────────

function getNotifier(req) {
  return req.app.locals.notifySubscribers ?? (() => {});
}

function buildWhereClause(filters) {
  const reserved = new Set(['limit', 'offset', 'order', 'select']);
  const conditions = [];
  const params = [];

  for (const [key, val] of Object.entries(filters)) {
    if (reserved.has(key)) continue;
    // Support eq(column,value) style: ?column=eq.value
    if (typeof val === 'string' && val.startsWith('eq.')) {
      conditions.push(`${key} = ?`);
      params.push(val.slice(3));
    } else if (typeof val === 'string' && val.startsWith('like.')) {
      conditions.push(`${key} LIKE ?`);
      params.push(val.slice(5));
    } else if (typeof val === 'string' && val.startsWith('gte.')) {
      conditions.push(`${key} >= ?`);
      params.push(val.slice(4));
    } else if (typeof val === 'string' && val.startsWith('lte.')) {
      conditions.push(`${key} <= ?`);
      params.push(val.slice(4));
    } else {
      conditions.push(`${key} = ?`);
      params.push(val);
    }
  }

  return {
    clause: conditions.length ? `WHERE ${conditions.join(' AND ')}` : '',
    params,
  };
}

// ─── GET /api/{{table}} ───────────────────────────────────────────────────────

router.get('/', (req, res) => {
  const { limit = 1000, offset = 0, order, select, ...filters } = req.query;
  const db = getDb();
  const { clause, params } = buildWhereClause(filters);

  // Sanitise order to prevent SQL injection
  const orderClause = order
    ? `ORDER BY ${String(order).replace(/[^a-zA-Z0-9_,. ]/g, '')}`
    : 'ORDER BY created_at DESC';

  const rows = db
    .prepare(`SELECT * FROM ${TABLE} ${clause} ${orderClause} LIMIT ? OFFSET ?`)
    .all(...params, Number(limit), Number(offset));

  res.json({ data: rows, error: null, count: rows.length });
});

// ─── GET /api/{{table}}/:id ───────────────────────────────────────────────────

router.get('/:id', (req, res) => {
  const row = getDb()
    .prepare(`SELECT * FROM ${TABLE} WHERE id = ?`)
    .get(req.params.id);

  if (!row) return res.status(404).json({ data: null, error: 'Row not found' });
  res.json({ data: row, error: null });
});

// ─── POST /api/{{table}} — insert ─────────────────────────────────────────────

router.post('/', (req, res) => {
  const db = getDb();
  const rows = Array.isArray(req.body) ? req.body : [req.body];
  const inserted = [];

  const insertTx = db.transaction((row) => {
    const id = row.id ?? crypto.randomUUID();
    const cols = Object.keys(row).filter((k) => k !== 'id');
    const placeholders = cols.map(() => '?').join(', ');
    const vals = cols.map((c) => {
      const v = row[c];
      return typeof v === 'object' ? JSON.stringify(v) : v;
    });

    db.prepare(
      `INSERT INTO ${TABLE} (id${cols.length ? ', ' + cols.join(', ') : ''})
       VALUES (?${cols.length ? ', ' + placeholders : ''})`
    ).run(id, ...vals);

    return db.prepare(`SELECT * FROM ${TABLE} WHERE id = ?`).get(id);
  });

  try {
    for (const row of rows) {
      const result = insertTx(row);
      inserted.push(result);
      getNotifier(req)(TABLE, { eventType: 'INSERT', new: result });
    }
    const data = inserted.length === 1 ? inserted[0] : inserted;
    res.status(201).json({ data, error: null });
  } catch (err) {
    if (err.message?.includes('UNIQUE')) {
      return res.status(409).json({ data: null, error: 'Duplicate key violation' });
    }
    throw err;
  }
});

// ─── PUT /api/{{table}}/:id — update ─────────────────────────────────────────

router.put('/:id', (req, res) => {
  const db = getDb();
  const cols = Object.keys(req.body).filter((k) => k !== 'id');
  if (!cols.length) return res.status(400).json({ error: 'No fields provided to update' });

  const setClauses = cols.map((c) => `${c} = ?`).join(', ');
  const vals = cols.map((c) => {
    const v = req.body[c];
    return typeof v === 'object' ? JSON.stringify(v) : v;
  });

  db.prepare(
    `UPDATE ${TABLE} SET ${setClauses}, updated_at = datetime('now') WHERE id = ?`
  ).run(...vals, req.params.id);

  const updated = db.prepare(`SELECT * FROM ${TABLE} WHERE id = ?`).get(req.params.id);
  getNotifier(req)(TABLE, { eventType: 'UPDATE', new: updated });
  res.json({ data: updated, error: null });
});

// ─── DELETE /api/{{table}}/:id ────────────────────────────────────────────────

router.delete('/:id', (req, res) => {
  const db = getDb();
  const old = db.prepare(`SELECT * FROM ${TABLE} WHERE id = ?`).get(req.params.id);
  db.prepare(`DELETE FROM ${TABLE} WHERE id = ?`).run(req.params.id);
  getNotifier(req)(TABLE, { eventType: 'DELETE', old });
  res.json({ data: null, error: null });
});

// ─── POST /api/{{table}}/upsert ───────────────────────────────────────────────

router.post('/upsert', (req, res) => {
  const db = getDb();
  const rows = Array.isArray(req.body) ? req.body : [req.body];
  const upserted = [];

  const upsertTx = db.transaction((row) => {
    const id = row.id ?? crypto.randomUUID();
    const cols = Object.keys(row).filter((k) => k !== 'id');
    const placeholders = cols.map(() => '?').join(', ');
    const setClauses = cols.map((c) => `${c} = excluded.${c}`).join(', ');
    const vals = cols.map((c) => {
      const v = row[c];
      return typeof v === 'object' ? JSON.stringify(v) : v;
    });

    db.prepare(
      `INSERT INTO ${TABLE} (id${cols.length ? ', ' + cols.join(', ') : ''})
       VALUES (?${cols.length ? ', ' + placeholders : ''})
       ON CONFLICT(id) DO UPDATE SET ${setClauses}, updated_at = datetime('now')`
    ).run(id, ...vals);

    return db.prepare(`SELECT * FROM ${TABLE} WHERE id = ?`).get(id);
  });

  for (const row of rows) {
    const result = upsertTx(row);
    upserted.push(result);
    getNotifier(req)(TABLE, { eventType: 'UPSERT', new: result });
  }

  const data = upserted.length === 1 ? upserted[0] : upserted;
  res.json({ data, error: null });
});

module.exports = router;
