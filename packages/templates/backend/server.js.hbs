/**
 * Local Express backend — generated by WebToApp for {{appName}}
 * Replaces {{backend}} cloud backend with local SQLite + REST API
 */
const express = require('express');
const cors = require('cors');
const path = require('path');
const fs = require('fs');
const { initDatabase } = require('./database.cjs');
const authRouter = require('./auth.cjs');
{{#each tables}}
const {{this}}Router = require('./routes/{{this}}.cjs');
{{/each}}

const app = express();
const PORT = process.env.PORT || {{port}};
const HOST = '127.0.0.1'; // local only — never expose to network

// ─── Middleware ───────────────────────────────────────────────────────────────

app.use(cors({
  origin: [
    'http://localhost:{{devPort}}',
    'http://localhost:3000',
    'file://',
    /^file:\/\//,
  ],
  credentials: true,
}));

app.use(express.json({ limit: '50mb' }));
app.use(express.urlencoded({ extended: true, limit: '50mb' }));

// Request logger (dev only)
if (process.env.NODE_ENV === 'development') {
  app.use((req, _res, next) => {
    console.log(`[${new Date().toISOString()}] ${req.method} ${req.path}`);
    next();
  });
}

// ─── Static storage ───────────────────────────────────────────────────────────

const storageDir = path.join(__dirname, 'storage');
fs.mkdirSync(storageDir, { recursive: true });
app.use('/storage', express.static(storageDir));

// ─── Storage API ──────────────────────────────────────────────────────────────

const multer = require('multer');
const upload = multer({ dest: path.join(storageDir, '_tmp') });

app.post('/api/storage/:bucket', upload.single('file'), (req, res) => {
  const { bucket } = req.params;
  const filePath = req.body.path ?? req.file.originalname;
  const destDir = path.join(storageDir, bucket, path.dirname(filePath));
  fs.mkdirSync(destDir, { recursive: true });
  const dest = path.join(storageDir, bucket, filePath);
  fs.renameSync(req.file.path, dest);
  res.json({ path: filePath });
});

app.get('/api/storage/:bucket/*', (req, res) => {
  const filePath = path.join(storageDir, req.params.bucket, req.params[0]);
  if (!fs.existsSync(filePath)) return res.status(404).json({ error: 'Not found' });
  res.sendFile(filePath);
});

app.delete('/api/storage/:bucket/*', (req, res) => {
  const filePath = path.join(storageDir, req.params.bucket, req.params[0]);
  fs.rmSync(filePath, { force: true });
  res.json({ success: true });
});

// ─── Auth ─────────────────────────────────────────────────────────────────────

app.use('/api/auth', authRouter);

// ─── Table routes ─────────────────────────────────────────────────────────────

{{#each tables}}
app.use('/api/{{this}}', {{this}}Router);
{{/each}}

// ─── SSE subscribe (replaces Supabase Realtime) ───────────────────────────────

const subscribers = new Map(); // table → Set<res>

function notifySubscribers(table, payload) {
  const subs = subscribers.get(table);
  if (!subs) return;
  const data = `data: ${JSON.stringify(payload)}\n\n`;
  for (const res of subs) {
    try { res.write(data); } catch { subs.delete(res); }
  }
}

app.get('/api/:table/subscribe', (req, res) => {
  const { table } = req.params;
  res.setHeader('Content-Type', 'text/event-stream');
  res.setHeader('Cache-Control', 'no-cache');
  res.setHeader('Connection', 'keep-alive');
  res.flushHeaders();

  if (!subscribers.has(table)) subscribers.set(table, new Set());
  subscribers.get(table).add(res);

  const heartbeat = setInterval(() => {
    try { res.write(':heartbeat\n\n'); } catch { clearInterval(heartbeat); }
  }, 30_000);

  req.on('close', () => {
    clearInterval(heartbeat);
    subscribers.get(table)?.delete(res);
  });
});

// Expose notifier for route modules
app.locals.notifySubscribers = notifySubscribers;

// ─── Health ───────────────────────────────────────────────────────────────────

app.get('/api/health', (_req, res) => {
  res.json({ status: 'ok', app: '{{appName}}', ts: new Date().toISOString() });
});

// ─── Error handling ───────────────────────────────────────────────────────────

app.use((_req, res) => res.status(404).json({ error: 'Not found' }));

app.use((err, _req, res, _next) => {
  console.error('[backend error]', err);
  res.status(500).json({ error: err.message ?? 'Internal server error' });
});

// ─── Start ────────────────────────────────────────────────────────────────────

async function start() {
  await initDatabase();
  app.listen(PORT, HOST, () => {
    console.log(`[WebToApp] {{appName}} backend ready → http://${HOST}:${PORT}`);
  });
}

start().catch((err) => {
  console.error('[WebToApp] Failed to start backend:', err);
  process.exit(1);
});

module.exports = app;
