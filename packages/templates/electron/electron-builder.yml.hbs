appId: {{appId}}
productName: {{appName}}
copyright: Copyright © {{year}} {{appName}}

directories:
  output: release
  buildResources: assets

files:
  - dist/**/*
  - electron/**/*
  {{#if includeBackend}}
  - backend/**/*
  {{/if}}
  - package.json
  - "!node_modules/.cache"
  - "!**/*.map"
  - "!**/*.ts"

{{#if includeBackend}}
extraResources:
  - from: backend/
    to: backend/
    filter:
      - "**/*"
      - "!**/*.ts"
{{/if}}

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
{{#if targets.windows}}
win:
  target:
    - target: nsis
      arch:
        - x64
        - arm64
  {{#if icon}}
  icon: {{icon}}
  {{/if}}
  requestedExecutionLevel: asInvoker
  {{#if signing.windows.publisherName}}
  # Code signing — set WIN_CSC_LINK and WIN_CSC_KEY_PASSWORD env vars (or see webtoapp.config.json)
  signingHashAlgorithms:
    - sha256
  certificateSubjectName: "{{signing.windows.publisherName}}"
  {{/if}}

nsis:
  oneClick: false
  allowToChangeInstallationDirectory: true
  createDesktopShortcut: true
  createStartMenuShortcut: true
  shortcutName: {{appName}}
  {{#if icon}}
  installerIcon: {{icon}}
  uninstallerIcon: {{icon}}
  {{/if}}
{{/if}}

# ---------------------------------------------------------------------------
# Linux
# NOTE: Building Linux targets from Windows requires mksquashfs which is not
# available on Windows. To build for Linux, use a Linux machine or GitHub Actions.
# ---------------------------------------------------------------------------
{{#if targets.linux}}
linux:
  target:
    - target: AppImage
      arch:
        - x64
    - target: deb
      arch:
        - x64
  {{#if icon}}
  icon: {{icon}}
  {{/if}}
  category: Utility
{{/if}}

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
{{#if targets.mac}}
mac:
  target:
    - target: dmg
      arch:
        - x64
        - arm64
    - target: zip
      arch:
        - arm64
  {{#if icon}}
  icon: {{icon}}
  {{/if}}
  # Hardened Runtime is required for notarization
  hardenedRuntime: true
  gatekeeperAssess: false
  entitlements: build/entitlements.mac.plist
  entitlementsInherit: build/entitlements.mac.plist
  {{#if signing.mac.teamId}}
  # Notarization — set APPLE_ID, APPLE_APP_SPECIFIC_PASSWORD, APPLE_TEAM_ID env vars
  notarize:
    teamId: "{{signing.mac.teamId}}"
  {{/if}}

dmg:
  sign: false
  contents:
    - x: 130
      y: 220
    - x: 410
      y: 220
      type: link
      path: /Applications
{{/if}}

# ---------------------------------------------------------------------------
# Auto-Updates — powered by electron-updater
# See: https://www.electron.build/auto-update
# ---------------------------------------------------------------------------
{{#if updates.provider}}
{{#if_eq updates.provider "github"}}
publish:
  provider: github
  owner: "{{updates.githubOwner}}"
  repo: "{{updates.githubRepo}}"
  private: false
  releaseType: release
{{/if_eq}}
{{#if_eq updates.provider "generic"}}
publish:
  provider: generic
  url: "{{updates.serverUrl}}"
  channel: "{{updates.channel}}"
{{/if_eq}}
{{#if_eq updates.provider "s3"}}
publish:
  provider: s3
  bucket: "{{updates.s3Bucket}}"
  region: "{{updates.s3Region}}"
  channel: "{{updates.channel}}"
{{/if_eq}}
{{else}}
# Auto-updates disabled. Add an 'updates' block to webtoapp.config.json to enable.
publish:
  provider: github
  owner: "your-github-username"
  repo: "your-repo-name"
  private: false
{{/if}}
