appId: {{appId}}
productName: {{appName}}
copyright: Copyright © {{year}} {{appName}}

directories:
  output: release
  buildResources: assets

files:
  - dist/**/*
  - electron/**/*
  - backend/**/*
  - package.json
  - "!node_modules/.cache"
  - "!**/*.map"

extraResources:
  - from: backend/
    to: backend/
    filter:
      - "**/*"
      - "!**/*.ts"

{{#if targets.windows}}
win:
  target:
    - target: nsis
      arch:
        - x64
        - arm64
  icon: {{icon}}
  requestedExecutionLevel: asInvoker

nsis:
  oneClick: false
  allowToChangeInstallationDirectory: true
  createDesktopShortcut: true
  createStartMenuShortcut: true
  shortcutName: {{appName}}
  installerIcon: {{icon}}
  uninstallerIcon: {{icon}}
{{/if}}

{{#if targets.linux}}
linux:
  target:
    - target: AppImage
      arch:
        - x64
    - target: deb
      arch:
        - x64
    - target: rpm
      arch:
        - x64
  icon: {{icon}}
  category: Utility
  maintainer: {{appName}} Team
{{/if}}

{{#if targets.mac}}
mac:
  target:
    - target: dmg
      arch:
        - x64
        - arm64
    - target: zip
      arch:
        - arm64
  icon: {{icon}}
  hardenedRuntime: true
  gatekeeperAssess: false
  entitlements: build/entitlements.mac.plist
  entitlementsInherit: build/entitlements.mac.plist

dmg:
  sign: false
  contents:
    - x: 130
      y: 220
    - x: 410
      y: 220
      type: link
      path: /Applications
{{/if}}

publish:
  provider: generic
  url: https://your-update-server.com/releases/
  channel: latest
