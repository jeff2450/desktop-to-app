/**
 * localAuth - generated by WebToApp
 *
 * Compatibility wrapper for auth transformers that were written against
 * Supabase-style auth helpers. It delegates to localApi.auth so converted
 * files do not import a missing '@/lib/localAuth' module.
 */

import { localApi } from './localApi';

type Session = { access_token?: string; user?: unknown } | null;
type AuthCallback = (event: string, session: Session) => void;

const listeners = new Set<AuthCallback>();
let cachedSession: Session = null;

async function readSession(): Promise<Session> {
  const result = await localApi.auth.getSession();
  cachedSession = result.data?.session ?? null;
  return cachedSession;
}

function notify(event: string, session: Session): void {
  cachedSession = session;
  for (const listener of listeners) listener(event, session);
}

export const localAuth = {
  async signIn({ email, password }: { email: string; password: string }) {
    const result = await localApi.auth.signInWithPassword({ email, password });
    const session = result.data?.session ?? null;
    if (!result.error) notify('SIGNED_IN', session);
    return result;
  },

  async signUp({ email, password }: { email: string; password: string }) {
    return localApi.auth.signUp({ email, password });
  },

  async signOut() {
    const result = await localApi.auth.signOut();
    notify('SIGNED_OUT', null);
    return result;
  },

  getSession: readSession,

  async getUser() {
    return localApi.auth.getUser();
  },

  onAuthChange(callback: AuthCallback) {
    listeners.add(callback);
    void readSession().then((session) => {
      callback(session ? 'SIGNED_IN' : 'SIGNED_OUT', session);
    });

    return {
      data: {
        subscription: {
          unsubscribe: () => listeners.delete(callback),
        },
      },
    };
  },

  useSession() {
    void readSession();
    return cachedSession;
  },
};

export default localAuth;
