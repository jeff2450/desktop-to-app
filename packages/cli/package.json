{
  "name": "@webtoapp/cli",
  "version": "1.0.0",
  "description": "WebToApp CLI — npx webtoapp convert",
  "type": "module",
  "bin": {
    "webtoapp": "./bin/webtoapp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node bin/webtoapp.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@webtoapp/builder": "workspace:*",
    "@webtoapp/core": "workspace:*",
    "@webtoapp/detectors": "workspace:*",
    "@webtoapp/transformers": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
