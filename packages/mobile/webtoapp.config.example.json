{
  "mode": "offline",
  "name": "Webtoapp",
  "version": "1.0.0",
  "appId": "com.example.myapp",
  "source": ".",
  "targets": [
    "windows",
    "linux",
    "android"
  ],
  "backend": {
    "type": "auto",
    "port": 3001
  },
  "auth": {
    "type": "local",
    "defaultAdmin": "admin@app.local"
  },
  "database": {
    "type": "sqlite"
  },
  "mobile": {
    "webDir": "dist",
    "android": {
      "minSdkVersion": 22,
      "targetSdkVersion": 34,
      "buildVariant": "debug"
    }
  }
}
