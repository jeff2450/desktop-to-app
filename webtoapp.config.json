{
  "$schema": "./webtoapp.config.schema.json",
  "name": "WebToApp",
  "version": "1.0.0",
  "author": "JEFF-PC",
  "appId": "dev.webtoapp.app",
  "source": ".",
  "output": "./output",
  "icon": "apps/web/public/favicon.png",
  "mode": "online",
  "targets": [
    "windows",
    "linux",
    "android"
  ],
  "backend": {
    "type": "auto",
    "port": 3001
  },
  "auth": {
    "type": "local",
    "defaultAdmin": "admin@app.local"
  },
  "database": {
    "type": "sqlite",
    "migrations": "supabase/migrations"
  },
  "behaviorParity": "warn",
  "devTools": false,
  "verbose": false,
  "dryRun": false,
  "cleanLogs": false,
  "mobile": {
    "webDir": "dist",
    "android": {
      "minSdkVersion": 22,
      "targetSdkVersion": 35,
      "buildVariant": "debug",
      "artifactType": "aab",
      "keystorePath": "release.jks",
      "keystoreAlias": "my-key-alias",
      "keystorePassword": "my-keystore-password"
    }
  }
}
